# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="QA Agent"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1
APP_PUBLISHED_PORT=8000

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"
GRAFANA_ADMIN_PASSWORD="replace-with-a-strong-password"

# Lightweight local tracing (no prompt/response/document content)
TRACING_ENABLED=true
TRACE_DIR=logs/traces
TRACE_FILE_RETENTION_DAYS=7
TRACE_SLOW_SPAN_THRESHOLD_MS=2000

# LLM Settings (official DeepSeek API, China)
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_ENABLED=false
EXPOSE_REASONING_CONTENT=false
DEFAULT_LLM_MODEL=deepseek-v4-flash
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true
# High-entropy server secret used to encrypt per-user API keys at rest.
USER_SETTINGS_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
# Users may only select provider endpoints approved by the platform operator.
ALLOWED_LLM_BASE_URLS="https://api.deepseek.com"

# Long-term memory: DeepSeek extracts memories; SiliconFlow embeds them.
LONG_TERM_MEMORY_MODEL=deepseek-v4-flash
LONG_TERM_MEMORY_EMBEDDER_MODEL=BAAI/bge-m3
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Knowledge Base / RAG Settings (SiliconFlow free embeddings)
# Get a free API key at: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY="your-siliconflow-api-key"
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=30
EMBEDDING_BATCH_SIZE=64
KNOWLEDGE_TABLE=knowledge_chunks
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SIMILARITY=0.3
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=100
